{
  "name": "umpra",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/sandbox/** --exclude tests/e2e/**",
    "test:sandbox": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "build:check": "node scripts/local-check.mjs build",
    "test:e2e": "playwright test",
    "sandbox:check": "node --env-file-if-exists=.env.local --import tsx scripts/sandbox-check.ts",
    "storage:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-storage.ts",
    "vision:check": "node --env-file-if-exists=.env.local --import tsx scripts/vision-check.ts",
    "audit:repo": "node scripts/audit-repo.mjs",
    "screenshots:generate": "node --import tsx scripts/make-screenshots.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "^6.0.10",
    "lucide-react": "^0.479.0",
    "next": "^15.2.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.3",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
