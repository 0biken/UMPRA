# Copy to .env.local and fill in. Never commit real values.
APP_URL=http://localhost:3000
DATABASE_URL=
SESSION_SECRET=            # 32+ random bytes, e.g. `openssl rand -base64 32`

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_VERIFY=true

ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=screenshots

AGENT_SWEEP_SECRET=
DEMO_MODE=false
MATCH_TIMEOUT_MIN=30
SECOND_SUBMISSION_TIMEOUT_MIN=15
RUN_SANDBOX_TESTS=
