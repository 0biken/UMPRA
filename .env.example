# Copy to .env.local and fill in. Never commit real values.
APP_URL=http://localhost:3000
DATABASE_URL=
SESSION_SECRET=            # 32+ random bytes, e.g. `openssl rand -base64 32`

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_VERIFY=true

ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=screenshots

AGENT_SWEEP_SECRET=
DEMO_MODE=false
MATCH_TIMEOUT_MIN=30
SECOND_SUBMISSION_TIMEOUT_MIN=15
RUN_SANDBOX_TESTS=

# Demo-only sandbox recipient emails, one per demo player, in player order.
DEMO_PAYPAL_RECIPIENTS=
# Only sandbox buyer credentials may be displayed on the DEMO_MODE landing page.
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# Manual approval prerequisite for test:sandbox; never use a production account.
SANDBOX_APPROVED_ORDER_ID=
SANDBOX_PAYOUT_RECIPIENT=
